SDKWORK_MANAGER_DEPLOYMENT_PROFILE=cloud
SDKWORK_MANAGER_ENVIRONMENT=development
SDKWORK_ENVIRONMENT=development
SDKWORK_IAM_ENVIRONMENT=development
SDKWORK_MANAGER_PROFILE_ID=cloud.development
SDKWORK_MANAGER_APPLICATION_PUBLIC_HTTP_URL=https://admin-dev.sdkwork.com
SDKWORK_MANAGER_PC_DEV_BIND=0.0.0.0:5190
SDKWORK_MANAGER_CORS_ALLOWED_ORIGINS=http://127.0.0.1:5190
SDKWORK_CORS_ALLOWED_ORIGINS=http://127.0.0.1:5190
SDKWORK_IAM_CORS_ALLOWED_ORIGINS=http://127.0.0.1:5190
SDKWORK_MANAGER_PLATFORM_API_GATEWAY_HTTP_URL=https://api-dev.sdkwork.com
VITE_SDKWORK_MANAGER_APPLICATION_PUBLIC_HTTP_URL=https://admin-dev.sdkwork.com
VITE_SDKWORK_MANAGER_PLATFORM_API_GATEWAY_HTTP_URL=https://api-dev.sdkwork.com
VITE_SDKWORK_MANAGER_ENVIRONMENT=development
VITE_SDKWORK_MANAGER_DEPLOYMENT_PROFILE=cloud

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_MANAGER_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN


# dev:cloud local debugging override (vite dev surface only; PNPM_SCRIPT_SPEC section 3).
# The domain edges above stay authoritative for cloud-mode builds and deployed
# services. The development runtime instead binds every gateway-attached base
# URL to the sdkwork-api-cloud-gateway started by its own dev command
# (bind 127.0.0.1:3900), so dev:cloud quick-starts and debugs against the
# local gateway process.
SDKWORK_LOCAL_PLATFORM_API_GATEWAY_HTTP_URL=http://127.0.0.1:3900
