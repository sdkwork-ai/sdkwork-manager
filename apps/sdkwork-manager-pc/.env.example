# Browser-visible VITE_* configuration contains public endpoints and non-secret runtime choices only.
# Private Node-side dev bootstrap input. pnpm dev generates a disposable value when blank.
# Never rename this key to VITE_* or expose it through public runtime config.
SDKWORK_ACCESS_TOKEN=

# Local application ingress. IAM app/backend routes are mounted by the Manager Rust assembly.
# In standalone, all Manager and dependency SDKs resolve through this ingress.
VITE_SDKWORK_MANAGER_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:18092

# IAM runtime derives its mode from the standard browser lifecycle environment
# and deployment profile. The former IAM-specific keys remain read-only
# compatibility fallbacks and must not be added to new environment files.
VITE_SDKWORK_MANAGER_ENVIRONMENT=development
VITE_SDKWORK_MANAGER_DEPLOYMENT_PROFILE=standalone
VITE_SDKWORK_MANAGER_DEFAULT_LOCALE=zh-CN
VITE_SDKWORK_MANAGER_FALLBACK_LOCALE=en-US

# Optional local-only development prefill. Keep values blank in tracked files.
# VITE_SDKWORK_MANAGER_AUTH_DEV_PREFILL_ENABLED=false
# VITE_SDKWORK_MANAGER_AUTH_DEV_DEFAULT_ACCOUNT=
# VITE_SDKWORK_MANAGER_AUTH_DEV_DEFAULT_PASSWORD=

# --- Deploy application identity anchor (required build and runtime input) ---
# The public application access token's `app_id`/`aud` are this installation's
# deploy application id, not a repository-owned runtime id: IAM suppresses a token
# carrying the retired runtime app id. Export the anchor on the build host before
# `pnpm workflow:materialize-client-env`, which rewrites every committed client env
# profile of the declared surfaces with it, and keep it set at runtime.
# The materializer fails, naming this variable, when it is unset or empty, so a
# build can never fall back to a compiled-in application id.
SDKWORK_DEPLOY_APPLICATION_ID=
