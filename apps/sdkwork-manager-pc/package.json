{
  "name": "@sdkwork/manager-pc-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm dev:standalone",
    "install:bootstrap": "node ../../scripts/dev/manager-bootstrap.mjs",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm --dir ../.. run test:vitest",
    "lint": "pnpm run typecheck",
    "dev:standalone": "pnpm exec sdkwork-app dev --root ../.. --deployment-profile standalone",
    "dev:cloud": "pnpm exec sdkwork-app dev --root ../.. --deployment-profile cloud",
    "stop": "pnpm exec sdkwork-app stop --root ../..",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "verify": "pnpm check",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build:dev": "node ../../../sdkwork-specs/tools/build-browser-client.mjs --app-root . --environment dev",
    "build:test": "node ../../../sdkwork-specs/tools/build-browser-client.mjs --app-root . --environment test",
    "build:staging": "node ../../../sdkwork-specs/tools/build-browser-client.mjs --app-root . --environment staging",
    "build:prod": "node ../../../sdkwork-specs/tools/build-browser-client.mjs --app-root . --environment prod",
    "build:dev:cloud": "node ../../../sdkwork-specs/tools/build-browser-client.mjs --app-root . --environment dev --deployment-profile cloud",
    "build:test:cloud": "node ../../../sdkwork-specs/tools/build-browser-client.mjs --app-root . --environment test --deployment-profile cloud",
    "build:staging:cloud": "node ../../../sdkwork-specs/tools/build-browser-client.mjs --app-root . --environment staging --deployment-profile cloud",
    "build:prod:cloud": "node ../../../sdkwork-specs/tools/build-browser-client.mjs --app-root . --environment prod --deployment-profile cloud"
  },
  "dependencies": {
    "@sdkwork/i18n-pc-react": "workspace:*",
    "@sdkwork/iam-credential-entry": "workspace:*",
    "@sdkwork/manager-pc-core": "workspace:*",
    "@sdkwork/manager-pc-admin-core": "workspace:*",
    "@sdkwork/manager-pc-admin-drive": "workspace:*",
    "@sdkwork/manager-pc-admin-iam": "workspace:*",
    "@sdkwork/manager-pc-admin-payment": "workspace:*",
    "@sdkwork/manager-pc-admin-trade": "workspace:*",
    "@sdkwork/manager-pc-admin-marketing": "workspace:*",
    "@sdkwork/manager-pc-admin-membership": "workspace:*",
    "@sdkwork/manager-pc-admin-customer": "workspace:*",
    "@sdkwork/manager-pc-shell": "workspace:*",
    "@sdkwork/manager-pc-user": "workspace:*",
    "@sdkwork/ui-pc-react": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router-dom": "catalog:",
    "tailwindcss": "^4.2.2",
    "@tailwindcss/vite": "^4.2.2"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  }
}
