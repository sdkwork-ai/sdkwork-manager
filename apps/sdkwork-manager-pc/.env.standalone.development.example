# Local browser configuration. This file is a template; copy values only into the ignored credential bundle or the local
# process environment; `.env.standalone.development` is the materialized scope file.
# Private Node-side bootstrap input; pnpm dev generates a disposable value when blank.
SDKWORK_ACCESS_TOKEN=
VITE_SDKWORK_MANAGER_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:18092
VITE_SDKWORK_MANAGER_ENVIRONMENT=development
VITE_SDKWORK_MANAGER_DEPLOYMENT_PROFILE=standalone
VITE_SDKWORK_MANAGER_DEFAULT_LOCALE=zh-CN
VITE_SDKWORK_MANAGER_FALLBACK_LOCALE=en-US
